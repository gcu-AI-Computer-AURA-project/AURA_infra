server {
    listen 80;
    server_name api.dev-aura.r-e.kr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /actuator/health {
        proxy_pass http://aura-server:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.dev-aura.r-e.kr;

    ssl_certificate /etc/letsencrypt/live/api.dev-aura.r-e.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.dev-aura.r-e.kr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location / {
        proxy_pass http://aura-server:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }
}
